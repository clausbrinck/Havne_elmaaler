# Kopiér til .env og udfyld:  cp .env.example .env && nano .env

# --- Generelt ---------------------------------------------------------
KLUB_NAVN=Aabenraa Sejl Club
# Adressen brugerne går ind på (bruges i links i mails)
BASE_URL=http://elmaaler.local:8000
TZ=Europe/Copenhagen
METER_COUNT=200

# Første havnekontor-login (oprettes kun ved første start). Skift koden bagefter!
ADMIN_EMAIL=havnekontor@aabenraa-sejlclub.dk
ADMIN_PASSWORD=SkiftMig-123

# --- Home Assistant ---------------------------------------------------
SOURCE=homeassistant
HA_URL=http://192.168.1.10:8123
# Profil i Home Assistant -> Sikkerhed -> Langtids-adgangstokens -> Opret token
HA_TOKEN=
# Entitets-navne i Home Assistant (ZHA). Enheden navngives elmaaler-001, elmaaler-002 ...
# Standarden passer til ZHA og behøver normalt ikke sættes. Flere bud adskilles med komma.
#HA_ENERGY_ENTITY=sensor.elmaaler_{nr:03d}_summation_delivered,sensor.elmaaler_{nr:03d}_energy
#HA_POWER_ENTITY=sensor.elmaaler_{nr:03d}_power
#HA_LQI_ENTITY=sensor.elmaaler_{nr:03d}_lqi,sensor.elmaaler_{nr:03d}_linkquality
POLL_SECONDS=30
STORE_MINUTES=15

# --- Email (SMTP) -----------------------------------------------------
# Eksempel Simply.com: SMTP_HOST=smtp.simply.com SMTP_PORT=587 SMTP_SECURITY=starttls
# Eksempel Gmail (app-adgangskode): smtp.gmail.com 587 starttls
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=elmaaler@aabenraa-sejlclub.dk

# --- Backup -----------------------------------------------------------
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=30
# Ekstra kopi (USB-disk/NAS mountet i docker-compose.yml)
BACKUP_EXTRA_DIR=
# Krypteret kopi i OneDrive via rclone – se docs/07-elmaaler-installation.md, "Backup i OneDrive"
BACKUP_RCLONE_REMOTE=

# --- Sikkerhed --------------------------------------------------------
# Sæt til true når siden kører bag HTTPS (se docs/08-adgang-udefra.md)
COOKIE_SECURE=false

# --- Kun til test: simulerede målere i stedet for Home Assistant -------
# SOURCE=sim
# SIM_BACKFILL_DAYS=45
